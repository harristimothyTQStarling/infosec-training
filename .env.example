# TQStarling InfoSec Training — environment configuration
# Copy to .env for local development. On Railway, set these as service
# variables (Settings → Variables). Never commit real values.

# --- Server ---------------------------------------------------------
PORT=8080
# Public origin of the deployment; used to build the Entra redirect URI.
# Railway: https://<your-service>.up.railway.app (or custom domain)
BASE_URL=http://localhost:8080
# Long random string; sign session cookies. Generate with:
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Database -------------------------------------------------------
# Railway: reference the Postgres plugin -> ${{Postgres.DATABASE_URL}}
DATABASE_URL=
# Set true when connecting over Railway's PUBLIC endpoint (TLS required).
# Leave unset/false on the internal network or local Postgres.
DATABASE_SSL=false

# --- Microsoft Entra ID SSO (tqstarling.com tenant) -----------------
# From the app registration in Entra admin center (see README runbook).
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# --- Local development only -----------------------------------------
# Bypass Entra sign-in with a fixed test user. Ignored in production.
# AUTH_DISABLED=true
